NEXT_PUBLIC_APP_NAME=TravelOS
DATABASE_URL="postgresql://user:password@localhost:5432/travelos"

# Family PIN is off unless this is exactly 1. Production should set 1.
# TRAVELOS_REQUIRE_FAMILY_PIN=1
# TRAVELOS_ADMIN_PIN=

# Public storefront origin for metadataBase / sitemap / share links.
# Defaults to Cloudflare workers.dev. Do not set this to *.vercel.app (ignored).
# SITE_URL=https://travelos2.chao-jason.workers.dev
# NEXT_PUBLIC_SITE_URL=https://travelos2.chao-jason.workers.dev

# Optional. Override Drive widget source: 567750 (Cloudflare) or 550313 (Vercel spare).
# TRAVELOS_TRAVELPAYOUTS_DRIVE_SRC=567750

# Optional. Background voice-to-text on Bench uses Vercel AI Gateway first.
# AI_GATEWAY_API_KEY=
