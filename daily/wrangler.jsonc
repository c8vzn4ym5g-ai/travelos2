{
 "name":"travelos-baby-daily-preview",
 "main":"worker.js",
 "compatibility_date":"2026-11-03",
 "workers_dev":true,
 "assets":{"directory":"web","binding":"ASSETS","run_worker_first":["/api/*"]},
 "ai":{"binding":"AI"},
 "durable_objects":{"bindings":[{"name":"DAILY_WAREHOUSE","class_name":"DailyWarehouse"}]},
 "migrations":[{"tag":"daily-v1","new_sqlite_classes":["DailyWarehouse"]}],
 "triggers":{"crons":["*/15 * * * *"]}
}
