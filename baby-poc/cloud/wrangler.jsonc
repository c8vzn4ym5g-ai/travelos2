{
  "name": "travelos-baby-poc",
  "main": "worker.js",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "../web",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/book/*"]
  },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "FICTIONAL_WAREHOUSE", "class_name": "FictionalWarehouse" }
    ]
  },
  "migrations": [
    { "tag": "fictional-warehouse-v1", "new_sqlite_classes": ["FictionalWarehouse"] }
  ]
}
